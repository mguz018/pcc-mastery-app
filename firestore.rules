rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read their own record, but only the Stripe webhook (via the
    // Admin SDK, which bypasses these rules) may write it. This is what stops
    // someone granting themselves premium from the browser console.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
